{
  "author": "joabssilveira",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "husky": "^9.1.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "standard-version": "^9.5.0",
    "tslib": "^2.6.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=10"
  },
  "files": [
    "dist",
    "src"
  ],
  "homepage": "https://github.com/joabssilveira/fwork-react-mui-theme-mode-provider",
  "keywords": [
    "react",
    "mui-theme",
    "muitheme",
    "dark",
    "theme mode"
  ],
  "license": "MIT",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "name": "fwork-react-mui-theme-mode-provider",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "scripts": {
    "dev:example": "webpack serve --config appExample/webpack.config.js",
    "postbuild": "node postbuild.js",
    "build": "tsc --project tsconfig.cjs.json && tsc --project tsconfig.esm.json",
    "prepare": "husky",
    "release": "standard-version",
    "pub": "npm run build && npm run release && git push --follow-tags origin main && npm publish"
  },
  "version": "2.0.1",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    }
  }
}
